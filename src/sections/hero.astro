---
import { cliente } from "../data/cliente";
---

<section class="flex-column bg-dots">
  <h1>{cliente.nombre}</h1>
  <p>{cliente.descripcion}</p>
  <div class="buttons flex-row">
    <a class="button1" href={cliente.whatsapp} target="_blank" rel="noopener">
      <i class="bi bi-whatsapp"></i>Contáctanos
    </a>
    <a class="button2" href="#servicios">Saber más</a>
  </div>
</section>

<style>
  section {
    text-align: center;
    border-bottom: solid 1px var(--border-soft);
    min-height: 300px;
    gap: 8px;
  }

  h1 {
    font-size: 2.8rem;
    line-height: normal;
    font-weight: 300;
    letter-spacing: 18px;
    padding-left: 18px;
    color: var(--clr-primary);
  }

  p {
    font-size: 0.95rem;
  }

  .buttons {
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  @media (min-width: 750px) {
    h1 {
      font-size: 5rem;
    }
  }
</style>
