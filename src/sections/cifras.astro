---
// Cifras en una franja entre dos líneas finas, separadas por líneas verticales.
import { cliente } from "../data/cliente";

const { cifras } = cliente;
---

{
  cifras.length > 0 && (
    <section class="cifras">
      <ul>
        {cifras.map(({ numero, texto }) => (
          <li class="flex-column reveal">
            <strong class="tnum">{numero}</strong>
            <span class="eyebrow">{texto}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .cifras {
    padding-block: 0;
  }

  /* 2 por fila en celular. Las líneas entre cifras son el espacio de 1px sobre el color del borde */
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background-color: var(--clr-border);
    border-block: solid 1px var(--clr-border);
  }

  li {
    align-items: flex-start;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-4);
    background-color: var(--clr-bg);
  }

  /* Si sobra una, ocupa toda la fila */
  li:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  strong {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
  }

  /* Computador: todas en una fila */
  @media (min-width: 750px) {
    ul {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }

    li {
      padding: var(--space-6) var(--space-5);
    }

    li:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
</style>
