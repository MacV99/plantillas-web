---
import TituloSeccion from "../components/titulo-seccion.astro";
import { cliente } from "../data/cliente";

const { encabezado, lista } = cliente.servicios;
---

{
  lista.length > 0 && (
    <section id="servicios">
      <TituloSeccion {...encabezado} />

      <ul class="grid">
        {lista.map(({ icono, titulo, texto, imagen }) => (
          <li class="card tarjeta flex-column reveal">
            {imagen ? <img src={imagen} alt={titulo} width="400" height="240" loading="lazy" /> : <i class={`bi ${icono} icon-box lg`} aria-hidden="true" />}
            <h3>{titulo}</h3>
            <p>{texto}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    width: 100%;
  }

  .tarjeta {
    align-items: flex-start;
    justify-content: flex-start;
    gap: var(--space-3);
    padding: var(--card-pad);
    box-shadow: none;
    transition: var(--transition);
  }

  img {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  h3 {
    color: var(--clr-primary);
  }

  /* La tarjeta se queda quieta: solo cambian borde y sombra */
  @media (hover: hover) {
    .tarjeta:hover {
      border-color: var(--card-border-hover);
      box-shadow: var(--shadow-sm);
    }
  }

  @media (min-width: 750px) {
    .grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }
</style>
