---
import { cliente } from "../data/cliente";
---

<section id="servicios">
  <h2>Servicios</h2>
  <p class="intro">Lo que hacemos por ti.</p>

  <ul class="grid">
    {
      cliente.servicios.map(({ icono, titulo, texto, imagen }) => (
        <li class="card flex-column">
          {imagen ? (
            <img src={imagen} alt={titulo} width="400" height="240" loading="lazy" />
          ) : (
            <i class={`bi ${icono}`} aria-hidden="true" />
          )}
          <h3>{titulo}</h3>
          <p>{texto}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .intro {
    margin-top: -10px;
    text-align: center;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    width: 100%;
  }

  .card {
    align-items: flex-start;
    gap: 10px;
    padding: 24px 20px;
    background-color: var(--clr-white);
    border: solid 1px var(--border-soft);
    border-radius: var(--radius-md);
    transition: var(--transition);
  }

  .card i {
    width: 44px;
    height: 44px;
    font-size: 1.3rem;
    color: var(--clr-accent);
    background-color: var(--bg-subtle);
    border-radius: var(--radius-sm);
  }

  .card img {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 3;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  h3 {
    font-size: 0.95rem;
    color: var(--clr-primary);
  }

  @media (hover: hover) {
    .card:hover {
      border-color: var(--border-hover);
      box-shadow: var(--shadow-sm);
      transform: translateY(-2px);
    }
  }

  @media (min-width: 750px) {
    .grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }
</style>
