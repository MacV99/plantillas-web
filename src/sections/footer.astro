---
import { cliente } from "../data/cliente";

const year = new Date().getFullYear();
---

<footer class="flex-column" id="contacto">
  <img src="/img/logo-png.avif" alt={`Logo ${cliente.nombre}`} class="logo" width="80" height="80" loading="lazy" />
  <h3>{cliente.nombre}</h3>

  <div class="contact-info flex-column">
    <a class="flex-row" href={`tel:${cliente.telefono.replace(/\s/g, "")}`}><i class="bi bi-telephone-fill"></i>{cliente.telefono}</a>
    <a class="flex-row" href={`mailto:${cliente.correo}`}><i class="bi bi-envelope-fill"></i>{cliente.correo}</a>
    <p class="flex-row"><i class="bi bi-geo-alt-fill"></i>{cliente.ciudad}</p>
  </div>

  <div class="flex-row follow">
    {
      cliente.redes.map(({ nombre, icono, url }) => (
        <a href={url} aria-label={nombre} target="_blank" rel="noopener">
          <i class={`bi ${icono}`} />
        </a>
      ))
    }
  </div>

  <small>©{year} {cliente.nombre}</small>
</footer>

<style>
  footer {
    background-color: var(--clr-dark);
    background-image: radial-gradient(circle, var(--footer-dots) 1px, transparent 1px);
    background-size: 22px 22px;
    margin-top: auto;
    color: var(--clr-white);
    padding-bottom: 20px;
  }

  .logo {
    width: 80px;
    height: 80px;
    margin-top: -80px;
    border-radius: 10px;
    object-fit: contain;
  }

  h3 {
    color: var(--clr-white);
  }

  .contact-info {
    gap: 6px;
  }

  .contact-info > * {
    gap: 8px;
    font-size: 0.9rem;
    color: var(--clr-white);
  }

  .follow {
    border: solid 1px var(--footer-border);
    border-radius: 50px;
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .follow i {
    font-size: 26px;
    color: var(--clr-white);
    padding: 16px 22px;
    transition: var(--transition);
  }

  small {
    color: var(--footer-muted);
    font-size: 0.75rem;
  }

  @media (hover: hover) {
    .follow i:hover {
      background-color: var(--footer-hover-bg);
    }
  }
</style>
