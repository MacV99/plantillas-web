---
import TituloSeccion from "../components/titulo-seccion.astro";
import { cliente } from "../data/cliente";

const { encabezado, lista } = cliente.marcas;
---

{
  lista.length > 0 && (
    <section id="marcas">
      <TituloSeccion {...encabezado} />

      <ul class="marcas flex-row">
        {lista.map(({ nombre, logo }) => (
          <li class="flex-row reveal">{logo ? <img src={logo} alt={nombre} height="40" loading="lazy" /> : <span>{nombre}</span>}</li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .marcas {
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: var(--space-3);
    width: 100%;
  }

  li {
    min-width: 140px;
    height: 72px;
    padding: var(--space-3) var(--space-5);
    background-color: var(--card-bg);
    border: solid 1px var(--card-border);
    border-radius: var(--radius-md);
  }

  /* Logos en gris para que ninguno grite más que otro; a color al pasar el mouse */
  img {
    width: auto;
    max-height: 40px;
    filter: grayscale(1);
    opacity: 0.7;
    transition: var(--transition);
  }

  span {
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--clr-text-muted);
  }

  @media (hover: hover) {
    li:hover img {
      filter: none;
      opacity: 1;
    }
  }
</style>
