---
import { cliente } from "../data/cliente";
---

<nav class="flex-column" aria-label="Menú principal">
  <button type="button" class="open-nav" aria-label="Abrir menú" aria-controls="overlay" aria-expanded="false">
    <i class="bi bi-list"></i>
  </button>

  <div class="flex-column bg-dots" id="overlay">
    {cliente.menu.map(({ texto, url }) => <a class="bg-dots" href={url}>{texto}</a>)}
    <button type="button" class="close-nav" aria-label="Cerrar menú">
      <i class="bi bi-x-lg"></i>
    </button>
  </div>
</nav>

<style>
  button {
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
  }

  .open-nav {
    font-size: 28px;
  }

  #overlay {
    display: none;
    position: fixed;
    inset: 0;
    gap: 7%;
    z-index: 100;
  }

  #overlay.abierto {
    display: flex;
  }

  .close-nav {
    position: absolute;
    top: 0;
    right: 0;
    margin: 28px;
    font-size: 24px;
    border-radius: 10px;
    padding: 7px;
    color: var(--clr-dark);
    border: solid 1px var(--clr-gray);
    background-color: var(--clr-white);
  }

  #overlay a {
    font-size: 18px;
    background-color: var(--clr-primary-light);
    padding: 10px 17px;
    border: solid 1px var(--clr-gray);
    border-radius: 14px;
    letter-spacing: 7px;
    width: 210px;
    text-align: center;
    text-transform: uppercase;
    color: var(--clr-dark);
  }

  @media (hover: hover) {
    #overlay a:hover {
      background-color: var(--bg-subtle);
      border-color: var(--border-hover);
      color: var(--clr-primary);
    }
  }

  @media (min-width: 750px) {
    .open-nav,
    .close-nav {
      display: none;
    }

    #overlay {
      display: flex;
      position: relative;
      inset: auto;
      flex-direction: row;
      gap: 7px;
      background: transparent;
    }

    #overlay a {
      font-size: 14px;
      letter-spacing: 0;
      width: auto;
      transition: var(--transition);
    }
  }
</style>

<script>
  const overlay = document.getElementById("overlay");
  const openBtn = document.querySelector(".open-nav");
  const closeBtn = document.querySelector(".close-nav");

  const toggle = (abrir: boolean) => {
    overlay?.classList.toggle("abierto", abrir);
    openBtn?.setAttribute("aria-expanded", String(abrir));
    document.body.classList.toggle("sin-scroll", abrir);
  };

  openBtn?.addEventListener("click", () => toggle(true));
  closeBtn?.addEventListener("click", () => toggle(false));
  overlay?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => toggle(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") toggle(false);
  });
</script>
