---
import { cliente } from "../data/cliente";

const bloques = [
  { icono: "bi-bullseye", titulo: "Nuestra misión", texto: cliente.mision },
  { icono: "bi-lightbulb-fill", titulo: "Nuestra visión", texto: cliente.vision },
];
---

<section class="flex-row">
  {
    bloques.map(({ icono, titulo, texto }) => (
      <div class="flex-column bg-dots">
        <h2 class="flex-row">
          <i class={`bi ${icono}`} />
          {titulo}
        </h2>
        <p>{texto}</p>
      </div>
    ))
  }
</section>

<style>
  section {
    flex-wrap: wrap;
    align-items: stretch;
  }

  div {
    align-items: flex-start;
    justify-content: flex-start;
    border: solid 1px var(--border-soft);
    padding: 27px 20px;
    border-radius: 18px;
    max-width: 400px;
    gap: 5px;
    transition: var(--transition);
  }

  h2 {
    gap: 6px;
    font-size: 1.1rem;
    color: var(--clr-primary);
  }

  i {
    color: var(--clr-accent);
  }

  @media (hover: hover) {
    div:hover {
      border-color: var(--border-hover);
      box-shadow: var(--shadow-sm);
    }
  }
</style>
