---
// Misión y visión en una sola tarjeta partida en dos. Texto vacío en cliente.ts = no aparece.
import { cliente } from "../data/cliente";

const bloques = [
  { titulo: "Misión", texto: cliente.mision },
  { titulo: "Visión", texto: cliente.vision },
].filter(({ texto }) => texto);
---

{
  bloques.length > 0 && (
    <section class="mision">
      <div class="cells reveal">
        {bloques.map(({ titulo, texto }) => (
          <div class="flex-column">
            <span class="eyebrow">{titulo}</span>
            <p>{texto}</p>
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  .mision {
    padding-block: var(--space-5);
  }

  .cells {
    box-shadow: none;
  }

  .cells > div {
    align-items: flex-start;
    justify-content: flex-start;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  p {
    color: var(--clr-text);
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  @media (min-width: 750px) {
    .cells {
      --cells: 2;
    }

    .cells > div {
      padding: var(--space-6);
    }
  }
</style>
